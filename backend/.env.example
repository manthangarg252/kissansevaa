# Server & Database Configuration
PORT=5050
MONGO_URI=mongodb://localhost:27017/kissansevaai
ML_SERVICE_URL=http://127.0.0.1:8000

# Security (replace with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_strong_64_char_hex_secret

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_RETRIES=2
GEMINI_USER_RPM=20
GEMINI_USER_RPD=200

# Live Mandi Market Data (Data.gov.in AGMARKNET API)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
MARKET_API_KEY=your_data_gov_in_api_key_here

# Weather Cache TTL
WEATHER_CACHE_TTL_MINUTES=30
