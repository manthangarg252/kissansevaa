# KissanSevaAI Production Environment Template
# Copy to .env.prod on the deployment host (never commit .env.prod or real secrets):
#   cp .env.prod.example .env.prod && chmod 600 .env.prod

# --- Public Domain & TLS (Caddy) ---
# Point an DNS A record for this hostname to your GCP VM static external IP before starting Caddy.
KISSAN_API_DOMAIN=api.yourdomain.com
CADDY_ACME_EMAIL=ops@yourdomain.com
CADDYFILE_PATH=./infra/caddy/Caddyfile
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- MongoDB Authentication & Database ---
# Generate alphanumeric/hex passwords without URI-reserved symbols (@ : / # ? %):
#   openssl rand -hex 24
MONGO_INITDB_ROOT_USERNAME=kissan_root
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_24
MONGO_APP_DB=kissansevaai
MONGO_APP_USER=kissan_app
MONGO_APP_PASSWORD=REPLACE_WITH_DIFFERENT_OPENSSL_RAND_HEX_24

# --- Backend API Security & Runtime ---
NODE_ENV=production
PORT=5000
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
ML_SERVICE_URL=http://ml-service:8000

# --- External AI & Data APIs ---
# Required for crop second opinion, farmer chatbot, crop planner, voice extraction & livestock AI:
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_RETRIES=2
GEMINI_USER_RPM=20
GEMINI_USER_RPD=200

# Optional live Indian market mandi prices API key (data.gov.in AGMARKNET):
DATA_GOV_IN_API_KEY=
WEATHER_CACHE_TTL_MINUTES=30

# --- ML Service Crop Model Flags (DO NOT CHANGE V1 PRODUCTION ACTIVE) ---
ACTIVE_CROP_MODEL=v1
ENABLE_V3_SHADOW=true
V3_LOAD_FULL_FAISS=true
